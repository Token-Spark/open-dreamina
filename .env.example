# 用于加密 API Key 的密钥（首次部署时由 deploy.sh / deploy.ps1 自动生成）
# 手动生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时服务将拒绝启动，请勿使用示例值部署生产环境
ENCRYPTION_KEY=

# 七牛云对象存储：为 Seedance 参考素材提供公网临时 URL（14 天自动过期）。
# 配置后 Spark Hub 素材审核优先使用七牛云上传；未配置时回退到 public_base_url。
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
# QINIU_BUCKET=
# QINIU_DOMAIN=
# QINIU_AUDIT_EXPIRE_DAYS=14

# 3D 导演台 iframe 嵌入地址（二创协议见导演台 docs/embed-contract.md）。
# 默认使用 GitHub Pages 在线版；离线/内网部署时可改为自托管地址（如 http://localhost:8080/）。
# 留空则前端不显示导演台入口。
# DIRECTOR_DESK_URL=https://xiaozangao.github.io/3d-director-desk/
