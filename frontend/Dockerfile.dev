# 开发模式 Dockerfile：运行 Vite dev server，支持 HMR 热更新
# 源码通过 docker-compose volume 挂载，修改即时生效，无需重新 build 镜像
FROM node:20-alpine

WORKDIR /app

# 仅安装依赖（node_modules 通过匿名卷持久化，不被宿主机源码挂载覆盖）
COPY package.json package-lock.json* ./
RUN npm install --registry https://registry.npmmirror.com

EXPOSE 10131

CMD ["npm", "run", "dev"]
